# Discord
BOT_TOKEN=
CLIENT_ID=
CLIENT_SECRET=

# Dashboard
SESSION_SECRET=change-this-to-at-least-32-random-characters
DASHBOARD_URL=http://localhost:3000
REDIRECT_URI=http://localhost:3000/callback
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Optional: restrict special access on the official support server
SUPPORT_GUILD_ID=
OWNER_ID=
DEVELOPER_ROLE_ID=

# Optional PostgreSQL. Without DATABASE_URL the bot safely uses data/config.json.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=5

# Testing/local dashboard mode (do not enable on the production bot)
DASHBOARD_ONLY=false
